<Window x:Class="Optimizator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optimizator" Width="1000" Height="660" Icon="Assets/app.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid Margin="12">
        <!-- Тінь окремим шаром, щоб текст лишався чітким -->
        <Border CornerRadius="22" Background="{StaticResource Bg}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.55" Color="Black"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="22" Background="{StaticResource Bg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============ Бокове меню ============ -->
                <Border Background="{StaticResource Side}" CornerRadius="22,0,0,22" MouseLeftButtonDown="Drag">
                    <DockPanel Margin="16,20,16,16">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,28">
                            <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource Accent}">
                                <TextBlock Text="O" FontSize="19" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Optimizator" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="FPS optimizer" FontSize="11.5" Foreground="{StaticResource Sub}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border DockPanel.Dock="Bottom" CornerRadius="14" Background="#1A1B22" Padding="14,12">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SideDot" Width="9" Height="9" Fill="{StaticResource Sub}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SideStatus" Text="Очікування гри" Margin="10,0,0,0" FontSize="12.5" Foreground="{StaticResource Sub}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel>
                            <RadioButton Style="{StaticResource NavItem}" Content="⚡  Головна" Tag="PageHome" IsChecked="True" Checked="Nav"/>
                            <RadioButton Style="{StaticResource NavItem}" Content="🎮  Ігри" Tag="PageGames" Checked="Nav"/>
                            <RadioButton Style="{StaticResource NavItem}" Content="🌀  Вентилятори" Tag="PageFans" Checked="Nav"/>
                            <RadioButton Style="{StaticResource NavItem}" Content="⚙  Налаштування" Tag="PageSettings" Checked="Nav"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ============ Контент ============ -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Background="Transparent" MouseLeftButtonDown="Drag">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
                            <Button Style="{StaticResource WinButton}" Content="—" Click="Minimize"/>
                            <Button Style="{StaticResource WinButton}" Content="✕" Click="CloseClick" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- ГОЛОВНА -->
                    <ScrollViewer x:Name="PageHome" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,0,28,24">
                        <StackPanel>
                            <TextBlock Text="Головна" Style="{StaticResource H1}" Margin="0,0,0,16"/>

                            <Border Style="{StaticResource CardBorder}" Padding="22">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="StatusRing" Width="64" Height="64" CornerRadius="32" BorderThickness="3" BorderBrush="#33343F">
                                        <TextBlock x:Name="StatusIcon" Text="⏸" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="StatusTitle" Text="Очікування гри" Style="{StaticResource H2}" FontSize="19"/>
                                        <TextBlock x:Name="StatusSub" Style="{StaticResource SubText}" Margin="0,4,0,0"
                                                   Text="Запусти Minecraft, Roblox, CS2 або іншу гру — буст увімкнеться сам і вимкнеться після виходу."/>
                                    </StackPanel>
                                    <Button x:Name="ManualBtn" Grid.Column="2" Style="{StaticResource AccentButton}" Content="Увімкнути зараз" Click="ManualBoost" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <UniformGrid Columns="3" Margin="0,0,0,0">
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,12">
                                    <StackPanel>
                                        <TextBlock Text="CPU" Style="{StaticResource SubText}"/>
                                        <TextBlock x:Name="CpuTemp" Text="— °C" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Margin="4,0,4,12">
                                    <StackPanel>
                                        <TextBlock Text="GPU" Style="{StaticResource SubText}"/>
                                        <TextBlock x:Name="GpuTemp" Text="— °C" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Margin="8,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Вентилятори" Style="{StaticResource SubText}"/>
                                        <TextBlock x:Name="FanSummary" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource CardBorder}" x:Name="OptionsCard">
                                <StackPanel>
                                    <TextBlock Text="Що вмикається під час гри" Style="{StaticResource H2}" Margin="0,0,0,14"/>
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PowerPlan}" Click="SaveSettings" Margin="0,0,0,12">
                                        <StackPanel><TextBlock Text="Максимальна продуктивність живлення"/><TextBlock Style="{StaticResource SubText}" Text="Схема «Висока продуктивність» / режим «Найкраща продуктивність»"/></StackPanel>
                                    </CheckBox>
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding GamePriority}" Click="SaveSettings" Margin="0,0,0,12">
                                        <StackPanel><TextBlock Text="Високий пріоритет гри"/><TextBlock Style="{StaticResource SubText}" Text="Процесор насамперед віддає час грі"/></StackPanel>
                                    </CheckBox>
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DisableEcoQoS}" Click="SaveSettings" Margin="0,0,0,12">
                                        <StackPanel><TextBlock Text="Без енергозбереження для гри"/><TextBlock Style="{StaticResource SubText}" Text="Windows не переводить гру на енергоефективні ядра (EcoQoS)"/></StackPanel>
                                    </CheckBox>
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ThrottleBackground}" Click="SaveSettings" Margin="0,0,0,12">
                                        <StackPanel><TextBlock Text="Пригальмувати фонові програми"/><TextBlock Style="{StaticResource SubText}" Text="Браузери, Discord, Steam, OneDrive тощо отримують нижчий пріоритет (не закриваються)"/></StackPanel>
                                    </CheckBox>
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding TimerResolution}" Click="SaveSettings" Margin="0,0,0,12">
                                        <StackPanel><TextBlock Text="Точний системний таймер"/><TextBlock Style="{StaticResource SubText}" Text="0.5 мс — рівніший frametime, менше мікрофризів"/></StackPanel>
                                    </CheckBox>
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding GpuHighPerformance}" Click="SaveSettings" Margin="0,0,0,12">
                                        <StackPanel><TextBlock Text="Дискретна відеокарта для гри"/><TextBlock Style="{StaticResource SubText}" Text="Для ноутбуків: Minecraft і Roblox часто стартують на вбудованій графіці"/></StackPanel>
                                    </CheckBox>
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PurgeStandby}" Click="SaveSettings">
                                        <StackPanel><TextBlock Text="Очистити кеш оперативної пам'яті"/><TextBlock Style="{StaticResource SubText}" Text="Корисно, якщо RAM 8 ГБ і менше"/></StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Журнал" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                                    <ItemsControl x:Name="LogList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource SubText}" Margin="0,2"/></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ІГРИ -->
                    <ScrollViewer x:Name="PageGames" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,0,28,24">
                        <StackPanel>
                            <TextBlock Text="Ігри" Style="{StaticResource H1}"/>
                            <TextBlock Style="{StaticResource SubText}" Margin="0,4,0,16"
                                       Text="Буст вмикається, коли запущена будь-яка увімкнена гра. Minecraft через лаунчер Zontas визначається автоматично."/>

                            <Border Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewGameName" Margin="0,0,8,0" ToolTip="Назва гри"/>
                                    <TextBox x:Name="NewGameExe" Grid.Column="1" Margin="0,0,8,0" ToolTip="Ім'я процесу, напр. FortniteClient-Win64-Shipping.exe"/>
                                    <Button Grid.Column="2" Style="{StaticResource AccentButton}" Content="Додати" Click="AddGame"/>
                                </Grid>
                            </Border>
                            <TextBlock Style="{StaticResource SubText}" Margin="4,-6,0,14" Text="Ліворуч — назва, праворуч — ім'я процесу з Диспетчера завдань (вкладка «Подробиці»)."/>

                            <ItemsControl x:Name="GamesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding ProcessesText}" Style="{StaticResource SubText}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Видалити" Click="RemoveGame" Tag="{Binding}" Margin="0,0,14,0" Padding="12,6"/>
                                                <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Click="SaveSettings" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ВЕНТИЛЯТОРИ -->
                    <ScrollViewer x:Name="PageFans" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,0,28,24">
                        <StackPanel>
                            <TextBlock Text="Вентилятори" Style="{StaticResource H1}"/>
                            <TextBlock x:Name="FanHint" Style="{StaticResource SubText}" Margin="0,4,0,16"
                                       Text="Перемикач вмикає ручне керування. Вимкнений — вентилятор працює автоматично (як задумав виробник)."/>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <CheckBox x:Name="FansOnlyInGame" Style="{StaticResource Switch}" Click="FanOptionChanged" Margin="0,0,0,12">
                                        <StackPanel><TextBlock Text="Ручні оберти лише під час гри"/><TextBlock Style="{StaticResource SubText}" Text="Після виходу з гри вентилятори повертаються в авто-режим"/></StackPanel>
                                    </CheckBox>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Захист від перегріву"/>
                                            <TextBlock Style="{StaticResource SubText}" Text="Якщо CPU або GPU гарячіші — всі вентилятори одразу йдуть в авто-режим"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider x:Name="FailsafeSlider" Width="160" Minimum="70" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FailsafeChanged"/>
                                            <TextBlock x:Name="FailsafeText" Width="54" TextAlignment="Right" VerticalAlignment="Center" Text="90 °C"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Style="{StaticResource GhostButton}" Content="Всі на максимум" Click="AllMax" Margin="0,0,8,0"/>
                                        <Button Style="{StaticResource GhostButton}" Content="Всі в авто" Click="AllAuto"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <ItemsControl x:Name="FansList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding RpmText}" Style="{StaticResource SubText}"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding Manual}" VerticalAlignment="Center" Content="Ручне"/>
                                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" IsEnabled="{Binding Manual}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="56"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Minimum="0" Maximum="100" Value="{Binding Percent, Mode=TwoWay}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding PercentText}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Вимкнути" Padding="10,5" Margin="12,0,0,0" Click="FanOff" Tag="{Binding}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- НАЛАШТУВАННЯ -->
                    <ScrollViewer x:Name="PageSettings" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,0,28,24">
                        <StackPanel>
                            <TextBlock Text="Налаштування" Style="{StaticResource H1}" Margin="0,0,0,16"/>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Колір акценту" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                                    <WrapPanel x:Name="Swatches">
                                        <WrapPanel.Resources>
                                            <Style TargetType="Button">
                                                <Setter Property="Width" Value="34"/>
                                                <Setter Property="Height" Value="34"/>
                                                <Setter Property="Margin" Value="0,0,10,0"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="b" CornerRadius="17" Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="0"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderThickness" Value="2"/></Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </WrapPanel.Resources>
                                        <Button Tag="#8B5CF6" Click="PickAccent" Background="#8B5CF6"/>
                                        <Button Tag="#22C55E" Click="PickAccent" Background="#22C55E"/>
                                        <Button Tag="#FACC15" Click="PickAccent" Background="#FACC15"/>
                                        <Button Tag="#3B82F6" Click="PickAccent" Background="#3B82F6"/>
                                        <Button Tag="#EF4444" Click="PickAccent" Background="#EF4444"/>
                                        <Button Tag="#EC4899" Click="PickAccent" Background="#EC4899"/>
                                        <Button Tag="#F97316" Click="PickAccent" Background="#F97316"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <CheckBox x:Name="AutoStart" Style="{StaticResource Switch}" Click="AutoStartChanged" Margin="0,0,0,12">
                                        <StackPanel><TextBlock Text="Запускати разом з Windows"/><TextBlock Style="{StaticResource SubText}" Text="Тихо стартує в треї і чекає на гру"/></StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="ToTray" Style="{StaticResource Switch}" Click="TrayChanged" Margin="0,0,0,12">
                                        <StackPanel><TextBlock Text="Закриття ховає в трей"/><TextBlock Style="{StaticResource SubText}" Text="Програма продовжує стежити за іграми"/></StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="Notify" Style="{StaticResource Switch}" Click="NotifyChanged">
                                        <StackPanel><TextBlock Text="Сповіщення"/><TextBlock Style="{StaticResource SubText}" Text="Показувати повідомлення біля годинника, коли буст вмикається і вимикається"/></StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Фонові програми, які пригальмовуються" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource SubText}" Margin="0,4,0,10" Text="Імена процесів через кому. Вони НЕ закриваються — лише отримують нижчий пріоритет поки ти граєш."/>
                                    <TextBox x:Name="BgApps" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="64" LostFocus="BgAppsChanged"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="VersionText" Style="{StaticResource SubText}" Margin="4,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
