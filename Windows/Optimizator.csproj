<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>Optimizator</AssemblyName>
    <RootNamespace>Optimizator</RootNamespace>

    <!-- Версію можна передати при збірці: -p:Version=1.2.0 -->
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <Product>Optimizator</Product>
    <Company>Optimizator</Company>
    <AssemblyTitle>Optimizator — FPS optimizer</AssemblyTitle>
    <Description>Автоматичний ігровий буст і керування вентиляторами</Description>
    <Copyright>© 2026 Optimizator</Copyright>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Датчики та керування вентиляторами (CPU / GPU / материнська плата) -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- Читання командного рядка java-процесів (визначення Minecraft) -->
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>

</Project>
